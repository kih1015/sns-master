# 로컬 웹 UI 포트
PORT=4321

# 인스타그램과 쓰레드는 이미지 파일을 직접 업로드할 수 없고, 공개 URL에서 이미지를 가져갑니다.
# cloudflared, ngrok 등의 터널로 이 서버를 외부에 연결한 뒤 그 주소를 입력합니다. (예: https://xxxx.trycloudflare.com)
# 터널로 들어온 요청에는 /media/ 경로의 이미지만 응답하고, UI와 API는 localhost에서만 접근할 수 있습니다.
PUBLIC_BASE_URL=

# Instagram API with Instagram Login (비즈니스 또는 크리에이터 계정, instagram_business_content_publish 권한)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Threads API (threads_basic, threads_content_publish 권한)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# X API (OAuth 1.0a 사용자 컨텍스트, 앱 권한은 Read and write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 릴스 화면에 표시할 계정 이름
BRAND_NAME=이슈브리핑
